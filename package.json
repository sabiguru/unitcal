    "express-static-gzip": "^3.0.0",
    "decimal.js": "^10.4.3",
    "next": "15.3.6",
    "next-auth": "^4.24.11",
    "next-mdx-remote": "^5.0.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
