    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cssnano": "^7.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
